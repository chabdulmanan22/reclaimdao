# Server Configuration
PORT=8000
MONGODB_URI=mongodb://localhost:27017/reclaimdao-db
NODE_ENV=development
JWT_SECRET=your_secure_jwt_secret_here

# Support SMTP Credentials
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@reclaimdao.org
SMTP_PASSWORD=your_support_smtp_password
EMAIL_SUPPORT=support@reclaimdao.org

# Info SMTP Credentials
INFO_SMTP_HOST=smtp.hostinger.com
INFO_SMTP_PORT=465
INFO_SMTP_SECURE=true
INFO_SMTP_USER=info@reclaimdao.org
INFO_SMTP_PASSWORD=your_info_smtp_password
EMAIL_INFO=info@reclaimdao.org

# General / Fallback Email Settings
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USERNAME=support@reclaimdao.org
EMAIL_PASSWORD=your_smtp_password
EMAIL_FROM=support@reclaimdao.org

# Initial Admin Credentials
ADMIN_USERNAME=ADMIN
ADMIN_EMAIL=admin@reclaimdao.org
ADMIN_PASSWORD=your_admin_password
CLIENT_URL=http://localhost:3001
